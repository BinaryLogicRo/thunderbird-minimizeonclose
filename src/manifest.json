{
  "manifest_version": 2,
  "applications": {
    "gecko": {
      "id": "minimizeonclose@binarylogic.ro",
      "update_url": "https://binarylogic.ro/minimizeonclose.json",
      "strict_min_version": "128.0",
      "strict_max_version": "*"
    }
  },
  "name": "Minimize on Close @binarylogic.ro",
  "description": "Causes Thunderbird's main window to minimize instead of closing. You can still close Thunderbird through the menu.",
  "version": "__BUILD_version__",
  "author": "BinaryLogicRo",
  "icons": {
    "64": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "ex_windows": {
      "schema": "experiment.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["ex_windows"]],
        "script": "experiment.js"
      }
    }
  }
}
